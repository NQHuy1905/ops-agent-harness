              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Happy path - status check",
      "item": [
        {
          "name": "Start run: check payments-api",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objective\": \"Check the status of payments-api\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"run_id\", body.id);",
                  "if (body.pending_approval) { pm.collectionVariables.set(\"tool_call_id\", body.pending_approval.tool_call_id); }",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"run status completed\", () => pm.expect(pm.response.json().status).to.eql(\"completed\"));"
                ]
