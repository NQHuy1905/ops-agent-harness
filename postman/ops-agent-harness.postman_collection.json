    {
      "name": "2. Incident - approve",
      "item": [
        {
          "name": "Start run: incident (pauses)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs"
              ]
            },
            "description": "Run pauses before create_incident; response has pending_approval.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objective\": \"checkout-web is down, create an incident\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"run_id\", body.id);",
                  "if (body.pending_approval) { pm.collectionVariables.set(\"tool_call_id\", body.pending_approval.tool_call_id); }",
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"run status awaiting_approval\", () => pm.expect(pm.response.json().status).to.eql(\"awaiting_approval\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve (with edit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/runs/{{run_id}}/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs",
                "{{run_id}}",
                "approval"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_call_id\": \"{{tool_call_id}}\",\n  \"decision\": \"approve\",\n  \"edited_args\": {\n    \"title\": \"checkout-web outage\",\n    \"description\": \"Checkout returns 5xx for all users since 12:00 UTC\",\n    \"severity\": \"critical\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"run status completed\", () => pm.expect(pm.response.json().status).to.eql(\"completed\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve again -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/runs/{{run_id}}/approval",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "runs",
                "{{run_id}}",
                "approval"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_call_id\": \"{{tool_call_id}}\",\n  \"decision\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Incidents for run",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/incidents?run_id={{run_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "incidents"
              ],
              "query": [
                {
                  "key": "run_id",
                  "value": "{{run_id}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exactly one incident\", () => pm.expect(pm.response.json().length).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
