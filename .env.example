# LLM provider: "scripted" (offline demo, no key) or "deepseek"
LLM_PROVIDER=scripted
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# Storage
DATABASE_URL=sqlite+aiosqlite:///./harness.db
MOCK_DATA_DIR=./data

# Execution limits & safety
MAX_STEPS=10
MAX_WALL_TIME_S=60
MAX_TOOL_CALLS_PER_STEP=5
MAX_MALFORMED_LLM_RESPONSES=2
LOOP_DETECT_THRESHOLD=3

# Tool execution
TOOL_TIMEOUT_S=5
TOOL_MAX_RETRIES=2
TOOL_RETRY_BASE_DELAY_S=0.2

# Observability
LOG_LEVEL=INFO
LOG_FILE=
OTEL_EXPORTER_OTLP_ENDPOINT=
